    "def extract_text(t):\n",
    "    if isinstance(t, list):\n",
    "        parts = []\n",
    "        for item in t:\n",
    "            if isinstance(item, dict) and \"text\" in item:\n",
    "                parts.append(str(item[\"text\"]))\n",
    "            else:\n",
    "                parts.append(str(item))\n",
    "        return \"\".join(parts)\n",
    "    return str(t)\n"
   ]
  },
