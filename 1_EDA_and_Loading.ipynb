    "# Extract scores\n",
    "def extract_consistency_score(msg):\n",
    "    # Find all numeric ratings in ارزیابی دانشجو section\n",
    "    m = re.findall(r'پیوستگی و یکپارچگی تدریس:\\s*(\\d+)', msg)\n",
    "    return m if m else None\n",
    "\n",
    "def extract_knowledge_score(msg):\n",
    "    # Find all numeric ratings in ارزیابی دانشجو section\n",
    "    m = re.findall(r'دانش عمومی:\\s*(\\d+)', msg)\n",
    "    return m if m else None\n",
    "\n",
    "def extract_delivery_score(msg):\n",
    "    # Find all numeric ratings in ارزیابی دانشجو section\n",
    "    m = re.findall(r'توانایی انتقال مطالب و نکات مهم درس:\\s*(\\d+)', msg)\n",
    "    return m if m else None\n",
    "\n",
    "def extract_management_score(msg):\n",
    "    # Find all numeric ratings in ارزیابی دانشجو section\n",
    "    m = re.findall(r'نحوه مدیریت کلاس\\(نظم و زمان\\):\\s*(\\d+)', msg)\n",
    "    return m if m else None\n",
    "\n",
    "def extract_responsiveness_score(msg):\n",
    "    # Find all numeric ratings in ارزیابی دانشجو section\n",
    "    m = re.findall(r'پاسخگویی\\(حضوری و غیرحضوری\\):\\s*(\\d+)', msg)\n",
    "    return m if m else None\n",
    "\n",
    "def extract_respect_score(msg):\n",
    "    # Find all numeric ratings in ارزیابی دانشجو section\n",
    "    m = re.findall(r'آداب و رفتار اجتماعی با دانشجویان:\\s*(\\d+)', msg)\n",
    "    return m if m else None"
   ]
